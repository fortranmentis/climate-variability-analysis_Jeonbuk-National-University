# Preserve the original research files byte for byte, including line endings.
* -text
*.md text eol=lf
*.py text eol=lf
*.svg text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.nc filter=lfs diff=lfs merge=lfs -text
*.gdat filter=lfs diff=lfs merge=lfs -text
*.fwrite filter=lfs diff=lfs merge=lfs -text
*.png binary
*.gz binary
*.xlsx binary
*.shp binary
*.shx binary
*.dbf binary
